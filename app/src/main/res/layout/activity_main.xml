<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Preview area (top), larger by default so the effect is easier to see. -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="#FF000000">

        <com.r112007.effecteditor.ui.EffectPreviewView
            android:id="@+id/preview_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Status / error message overlay: sits at the bottom of the preview pane
             and expands upward, so it never covers the code editor. -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="#E6000000"
            android:clickable="true"
            android:fadeScrollbars="false"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:maxLines="8"
            android:minHeight="28dp"
            android:padding="6dp"
            android:scrollbars="vertical"
            android:textColor="@color/teal_200"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />
    </FrameLayout>

    <!-- Code area (bottom). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Action buttons -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:fadeScrollbars="false"
                android:scrollbarSize="2dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <Button
                        android:id="@+id/btn_compile"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/action_compile"
                        android:textColor="@color/teal_200"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_export"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/action_export"
                        android:textColor="@color/teal_200"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_reset"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/action_reset"
                        android:textColor="@color/teal_200"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_reset_view"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/action_reset_view"
                        android:textColor="@color/teal_200"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_complete"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/action_complete"
                        android:textColor="@color/teal_200"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_undo"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/action_undo"
                        android:textColor="@color/teal_200"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_redo"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/action_redo"
                        android:textColor="@color/teal_200"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_toggle_keys"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/action_toggle_keys"
                        android:textColor="@color/teal_200"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_orientation"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/action_orientation"
                        android:textColor="@color/teal_200"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                            android:id="@+id/btn_format"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="@string/action_format"
                            android:textColor="@color/teal_200"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_refresh"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="@string/action_refresh"
                            android:textColor="@color/teal_200"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.r112007.effecteditor.ui.CodeEditorView
                    android:id="@+id/code_editor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/editor_bg"
                    android:gravity="top|start"
                    android:padding="8dp"
                    android:textColor="@color/editor_text"
                    android:textSize="14sp"
                    android:typeface="monospace" />

                <LinearLayout
                    android:id="@+id/line_tools_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right|center_vertical"
                    android:layout_marginEnd="48dp"
                    android:background="#E61A1B26"
                    android:orientation="vertical"
                    android:padding="4dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_copy_line"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/key_button_bg"
                        android:text="@string/action_copy_line"
                        android:textColor="@color/editor_text"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <Button
                        android:id="@+id/btn_cut_line"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/key_button_bg"
                        android:text="@string/action_cut_line"
                        android:textColor="@color/editor_text"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <Button
                        android:id="@+id/btn_delete_line"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/key_button_bg"
                        android:text="@string/action_delete_line"
                        android:textColor="@color/editor_text"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <Button
                        android:id="@+id/btn_clear_line"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/key_button_bg"
                        android:text="@string/action_clear_line"
                        android:textColor="@color/editor_text"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <Button
                        android:id="@+id/btn_paste_line"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/key_button_bg"
                        android:text="@string/action_paste_line"
                        android:textColor="@color/editor_text"
                        android:textSize="11sp"
                        android:typeface="monospace" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_toggle_line_tools"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="right|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/key_button_bg"
                    android:text="@string/action_toggle_line_tools"
                    android:textColor="@color/editor_text"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Termux-style extra keys bar (multi-line, not scrollable).
         Placed at the bottom of the root layout so it sits on top of the
         system soft keyboard when adjustResize is active. Hidden by default
         and shown or hidden only via the toggle-keys button. -->
    <LinearLayout
        android:id="@+id/extra_keys_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:orientation="vertical"
        android:padding="0dp"
        android:visibility="gone" />
</LinearLayout>
